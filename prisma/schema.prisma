generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  CREATOR
  BUSINESS
  CONSUMER
  ADMIN
}

enum VerificationStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum CampaignStatus {
  DRAFT
  ACTIVE
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum ContentType {
  video
  image
  article
  audio
}

enum ContentVisibility {
  public
  paid
}

enum PaymentType {
  SUBSCRIPTION
  PRODUCT_PURCHASE
  CAMPAIGN_PAYMENT
  WITHDRAWAL
  CAMPAIGN_DISBURSEMENT
}

enum SubscriptionStatus {
  ACTIVE
  EXPIRED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
  COMPLETED
}

enum OfferStatus {
  PENDING
  ACCEPTED
  DECLINED
}

model User {
  id                   String             @id @default(uuid())
  name                 String?
  email                String             @unique
  password             String
  profileImage         String?
  role                 Role               @default(CONSUMER)
  verificationStatus   VerificationStatus @default(PENDING)
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  creatorProfile       CreatorProfile?
  contents             Content[]
  campaigns            Campaign[]
  sentMessages         Message[]          @relation("SenderMessages")
  receivedMessages     Message[]          @relation("ReceiverMessages")
  paymentTransactions  PaymentTransaction[]
  premiumPurchases     PremiumPurchase[]
  applications         Application[]
  subscriptions        Subscription[]     @relation("SubscriberSubscriptions")
  creatorSubscriptions Subscription[]     @relation("CreatorSubscriptions")
}

model CreatorProfile {
  id              String   @id @default(uuid())
  userId          String   @unique
  bio             String?
  specialization  String?
  socialLinks     String?
  payout_account  String?
  earnings        Float    @default(0)
  followers       Int      @default(0)
  avatar          String?
  location        String?
  payout_network  String?
  subscriptionFee Float    @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  contents Content[]
}

model Content {
  id               String            @id @default(uuid())
  title            String
  description      String?
  contentUrl       String
  thumbnailUrl     String?
  type             ContentType
  visibility       ContentVisibility
  price            Float?
  currency         String?
  deletedAt        DateTime?
  creatorId        String
  creatorProfileId String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  creator          User             @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  creatorProfile   CreatorProfile?  @relation(fields: [creatorProfileId], references: [id])
  premiumPurchases PremiumPurchase[]
}

model Campaign {
  id                String         @id @default(uuid())
  businessId        String
  title             String
  description       String?
  budget            Int
  status            CampaignStatus @default(DRAFT)
  niche_filter      String
  min_audience_size Int
  max_creators      Int
  startDate         DateTime
  endDate           DateTime
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  business     User          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  applications Application[]
}

model Application {
  id         String      @id @default(uuid())
  campaignId String
  creatorId  String
  proposal   String?                    // ← the field you needed
  status     OfferStatus @default(PENDING)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  creator  User     @relation(fields: [creatorId], references: [id], onDelete: Cascade)

  @@unique([campaignId, creatorId])
  @@index([campaignId])
}

model PaymentTransaction {
  id             String        @id @default(uuid())
  userId         String
  amount         Float
  paymentType    PaymentType
  paymentStatus  PaymentStatus @default(PENDING)
  transactionRef String        @unique
  providerRef    String?
  idempotencyKey String?
  campaignId     String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([idempotencyKey, userId, paymentType])
  @@index([campaignId])
}

model Message {
  id             String    @id @default(uuid())
  senderId       String
  receiverId     String
  conversationId String
  message        String
  isRead         Boolean   @default(false)
  readAt         DateTime?
  deletedAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  sender   User @relation("SenderMessages", fields: [senderId], references: [id], onDelete: Cascade)
  receiver User @relation("ReceiverMessages", fields: [receiverId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@index([senderId])
  @@index([receiverId])
}

model PremiumPurchase {
  id        String   @id @default(uuid())
  userId    String
  contentId String
  status    String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id])
  content Content @relation(fields: [contentId], references: [id])
}

model Subscription {
  id           String             @id @default(uuid())
  subscriberId String
  creatorId    String
  amount       Float
  status       SubscriptionStatus @default(ACTIVE)
  startDate    DateTime           @default(now())
  endDate      DateTime
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  subscriber User @relation("SubscriberSubscriptions", fields: [subscriberId], references: [id], onDelete: Cascade)
  creator    User @relation("CreatorSubscriptions", fields: [creatorId], references: [id], onDelete: Cascade)

  @@unique([subscriberId, creatorId])
  @@index([creatorId])
  @@index([subscriberId])
}